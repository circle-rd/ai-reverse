# ── reverse-relay configuration ─────────────────────────────────────────────
# Copy to .env and adjust. .env is git-ignored; never commit real values.
# Secrets prefer the *_FILE form (docker secret) over the inline form; setting
# both forms for the same key is rejected at startup.

# Required: where agents dial the tunnel, and where LiteLLM calls the OpenAI
# surface. Keep the API listener on the private network: it is not a public
# endpoint, only LiteLLM should reach it.
RELAY_TUNNEL_LISTEN=0.0.0.0:8080
RELAY_API_LISTEN=0.0.0.0:8081

# Required: public origin of the tunnel listener as agents and the identity
# provider see it. Becomes the default token audience.
RELAY_PUBLIC_URL=https://relay.example.com
# Required: base URL LiteLLM uses to reach RELAY_API_LISTEN. Inside the same
# compose network this can stay internal. Origin only: the relay appends
# /{account}/v1 itself, where {account} is u-<username>.
RELAY_PUBLIC_API_BASE=http://reverse-relay:8081

# Required: bearer key LiteLLM presents to the OpenAI surface. The relay
# injects it into every deployment it registers.
RELAY_API_KEY=
# RELAY_API_KEY_FILE=/run/secrets/relay_api_key

# Required: AuthService origin issuing agent access tokens.
RELAY_AUTH_ISSUER=https://auth.example.com
# Audience and scope every tunnel token must carry. The audience defaults to
# RELAY_PUBLIC_URL; it must match the resource registered in AuthService.
# RELAY_AUTH_AUDIENCE=https://relay.example.com
# RELAY_AUTH_SCOPE=tunnel:serve

# Required: LiteLLM admin API origin.
RELAY_LITELLM_URL=http://litellm:4000
# Preferred: dedicated LiteLLM key limited to the model management routes the
# relay uses (GET /model/info, POST /model/new, POST /model/delete).
# RELAY_LITELLM_API_KEY=
# RELAY_LITELLM_API_KEY_FILE=/run/secrets/litellm_api_key
# Fallback when RELAY_LITELLM_API_KEY is unset: the LiteLLM master key. The
# relay logs relay.litellm_master_key_fallback when it uses this credential.
# RELAY_LITELLM_MASTER_KEY=
# RELAY_LITELLM_MASTER_KEY_FILE=/run/secrets/litellm_master_key

# LiteLLM provider prefix stored on registered deployments.
# RELAY_LITELLM_PROVIDER=hosted_vllm

# Interval between polls of each agent's model list (seconds).
RELAY_MODELS_POLL_SECS=5
# How long a vanished model stays registered (seconds).
RELAY_DEREGISTER_GRACE_SECS=30
# Reconcile loop period and full resync period (seconds).
RELAY_RECONCILE_INTERVAL_SECS=2
RELAY_RESYNC_INTERVAL_SECS=60

# Request deadlines and body limits.
RELAY_REQUEST_HEADERS_TIMEOUT_SECS=900
RELAY_IDLE_TIMEOUT_SECS=600
RELAY_MAX_REQUEST_BYTES=67108864
RELAY_LITELLM_TIMEOUT_SECS=15

# Caps on simultaneously upgraded tunnels (global and per account).
RELAY_MAX_TUNNELS=256
RELAY_MAX_TUNNELS_PER_USER=64

# Failed tunnel authentications per address before lockout.
RELAY_AUTH_FAILURE_THRESHOLD=5
RELAY_AUTH_FAILURE_WINDOW_SECS=60
RELAY_AUTH_LOCKOUT_SECS=60

# Set true when a reverse proxy (Traefik) terminates TLS in front of the relay,
# so the last X-Forwarded-For entry is the agent address.
RELAY_TRUST_FORWARDED_FOR=true

# Owner settings channel (price and parallel requests per model) and live node status.
# The relay pushes its inventory, signed with the shared secret, and applies the settings
# in the answer. Without it every model is served unpriced and unlimited and nothing is
# reported. URL, secret and id must be set together.
# RELAY_INVENTORY_URL=https://raiversed.example.com/webhooks/relay/inventory
# RELAY_INVENTORY_SECRET_FILE=/run/secrets/relay_inventory_secret
# RELAY_INVENTORY_RELAY_ID=relay-eu-1
# RELAY_INVENTORY_INTERVAL_SECS=15

# Log level; logs are JSON on stdout.
RUST_LOG=info
