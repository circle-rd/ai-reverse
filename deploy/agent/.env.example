# ── reverse-agent configuration ─────────────────────────────────────────────
# Copy to .env and adjust. .env is git-ignored; never commit real values.
# Secrets prefer the *_FILE form (docker secret) over the inline form; setting
# both forms for the same key is rejected at startup.

# Required: origin of the relay the agent dials. Use https in production.
AGENT_RELAY_URL=https://relay.example.com
# Required: local OpenAI-compatible engine. TLS to the engine is not supported.
AGENT_UPSTREAM_URL=http://127.0.0.1:30001

# Required: identity provider (CIRCLE AuthService). Must be https off loopback.
AGENT_AUTH_ISSUER=https://auth.example.com
# Required: OAuth client registered for the device flow as a public client
# (token_endpoint_auth_method=none), with the tunnel:serve scope.
AGENT_AUTH_CLIENT_ID=reverse-agent
# Audience requested for the access token: the relay's public URL.
# AGENT_AUTH_RESOURCE=https://relay.example.com
# Scopes requested at authorization (the relay requires tunnel:serve).
# AGENT_AUTH_SCOPE=openid profile offline_access tunnel:serve

# Engine credential, if the engine requires one. Exactly one of the two forms;
# both set is an error. If you use the file form with plain docker run (not the
# compose file), bind-mount the file yourself (see README).
# AGENT_UPSTREAM_API_KEY=
# AGENT_UPSTREAM_API_KEY_FILE=/run/secrets/upstream_api_key

# Reconnect backoff bounds (seconds).
AGENT_RECONNECT_MIN_SECS=1
AGENT_RECONNECT_MAX_SECS=30
# Bounds on TCP connect and on the tunnel upgrade (seconds).
AGENT_CONNECT_TIMEOUT_SECS=5
# Engine answer deadline (seconds) and body stall limit in both directions (seconds).
AGENT_UPSTREAM_HEADERS_TIMEOUT_SECS=900
AGENT_IDLE_TIMEOUT_SECS=600
# Interval between polls of the engine model list (seconds).
AGENT_MODELS_POLL_SECS=5
# Concurrent requests the engine accepts, when it does not report it (SGLang, vLLM;
# set it to your --max-running-requests / --max-num-seqs). llama.cpp reports its own.
# AGENT_MAX_SLOTS=8
# Time one short generation per start for the speed shown to the provider (true/false).
# AGENT_BENCHMARK=true
# Interval between load samples of the engine, host and GPUs (seconds).
AGENT_STATUS_POLL_SECS=5
# Models announced although the engine's /v1/models omits them (comma-separated).
# AGENT_EXTRA_MODELS=perplexity-ai/pplx-embed-v1-0.6b
# Optional override: capability tags replacing every detected tag of the named models:
# model=tag[,tag][;model=...]. Tags are detected from the engine (Ollama, SGLang,
# llama.cpp) and the hub; set this only for ids they do not classify.
# AGENT_MODEL_TAGS=qwen3.8-flash-next=text,tools
# Classify models via the Hugging Face pipeline_tag. While this is true, model
# ids are sent to the hub; set false to keep them on the box (or on air-gapped
# hosts). HTTPS_PROXY/NO_PROXY are honored for this lookup.
# AGENT_HF_METADATA=true
# AGENT_HF_URL=https://huggingface.co
# AGENT_HF_TOKEN_FILE=/run/secrets/hf_token
AGENT_HF_TIMEOUT_SECS=5
# Largest request body accepted from the relay (bytes).
AGENT_MAX_REQUEST_BYTES=67108864
# Where the refresh token and agent id are persisted (writable by UID 65532).
AGENT_CREDENTIAL_FILE=/var/lib/reverse-agent/credential
# Optional owner-only host identity. Mount the host machine-id read-only as shown in
# compose.example.yml; each agent must still use its own credential directory.
# AGENT_MACHINE_ID_FILE=/run/host-machine-id
# AGENT_HOSTNAME=local-node
# Use the local hostname only, never an IP-derived or reverse-DNS name.
# Allow plain HTTP to a non-loopback relay (never in production).
AGENT_INSECURE_TRANSPORT=false

# Log level; logs are JSON on stdout.
RUST_LOG=info
